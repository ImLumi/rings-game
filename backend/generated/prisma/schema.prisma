// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @default("Player") @db.Char(255)
  role          Role      @default(player)
  accessToken   String    @db.Text
  ready         Boolean   @default(false)
  score         Int       @default(0)
  playerOneGame GameRoom? @relation("player1_games")
  playerTwoGame GameRoom? @relation("player2_games")
  currentPlayer GameRoom? @relation("current_player_games")
}

model GameRoom {
  id              Int      @id @default(autoincrement())
  inviteCode      Int
  status          Status   @default(prepare)
  player1Id       String   @unique @db.Uuid
  player1         User     @relation(name: "player1_games", fields: [player1Id], references: [id], onDelete: Cascade)
  player2Id       String?  @unique @db.Uuid
  player2         User?    @relation(name: "player2_games", fields: [player2Id], references: [id], onDelete: Cascade)
  currentRound    Int      @default(1)
  currentPlayer   User?    @relation(name: "current_player_games", fields: [currentPlayerId], references: [id], onDelete: Cascade)
  currentPlayerId String?  @unique @db.Uuid
  maxRound        Int      @default(5)
  puzzles         Puzzle[]
}

model Puzzle {
  id              Int        @id @default(autoincrement())
  imageUrl        String     @db.Text
  taskText        String     @db.Text
  size            Int        @default(600)
  targetPositionX Float
  targetPositionY Float
  targetRadius    Float
  gameRooms       GameRoom[]
}

enum Role {
  player
  admin
}

enum Status {
  prepare
  running
  ended
}
